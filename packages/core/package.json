{
  "name": "@camelkit/core",
  "version": "0.1.0",
  "description": "CamelKit Client Core",
  "keywords": [
    "camelkit",
    "evilquest",
    "plugin",
    "typescript",
    "types",
    "definitions",
    "framework"
  ],
  "homepage": "https://github.com/CamelKit/Client#readme",
  "bugs": {
    "url": "https://github.com/CamelKit/Client/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CamelKit/Client.git"
  },
  "license": "GPL-3.0-only",
  "author": "CamelKit Team",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "directories": {
    "doc": "docs"
  },
  "files": [
    "dist/**/*.d.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node esbuild.mjs && tsc --emitDeclarationOnly",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "acorn": "^8.15.0",
    "acorn-walk": "^8.3.4",
    "idb": "^8.0.3",
    "on-change": "^5.0.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.8",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
